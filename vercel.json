{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "functions": {
        "api/**/*.php": {
            "runtime": "vercel-php@0.7.3",
            "maxDuration": 60
        }
    },
    "routes": [
        { "src": "/(includes|services|storage|data|vendor|credentials)(/.*)?", "status": 404 },
        { "src": "/(.*\\.(json|lock|md|example|log))", "status": 404 },
        { "src": "/\\..*", "status": 404 },
        { "src": "/router\\.php", "status": 404 },
        { "src": "/assets/(.*)", "dest": "/assets/$1" },
        { "src": "/talentflow/?", "dest": "/talentflow/index.html" },
        { "src": "/talentflow/(.*)", "dest": "/talentflow/$1" },
        { "src": "/api/(.*\\.php)", "dest": "/api/$1" },
        { "src": "/", "dest": "/api/index.php?__pdi_rota=index.php" },
        { "src": "/(.+)", "dest": "/api/index.php?__pdi_rota=$1" }
    ]
}
