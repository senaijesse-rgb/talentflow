# Ambiente: local | staging | production
# Credenciais de teste só aparecem quando APP_ENV=local.
APP_ENV=local
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

# Fonte de dados: mock (arquivo JSON local) | sheets (Google Sheets API)
DATA_SOURCE=mock

# Google Sheets
GOOGLE_SHEETS_ID=
# Caminho para o JSON da conta de serviço (fora do diretório público)
# ou o conteúdo JSON completo em uma única linha.
GOOGLE_SERVICE_ACCOUNT_JSON=

# n8n
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Gmail (usado pelos fluxos do n8n)
GMAIL_FROM_NAME=
GMAIL_FROM_EMAIL=

# Sessão
SESSION_IDLE_MINUTES=30
SESSION_REMEMBER_DAYS=7

# Defina true apenas atrás de proxy reverso confiável (usa X-Forwarded-For para o IP)
TRUST_PROXY=false
